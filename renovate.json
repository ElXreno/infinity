{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "forkProcessing": "enabled",
  "enabledManagers": ["poetry", "github-actions"],
  "ignorePaths": ["libs/embed_package/**", "libs/client_infinity/**", "infra/**"],
  "timezone": "Europe/Moscow",
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "The python constraint states which interpreters the package supports, raising it drops 3.12 and 3.13 and makes poetry resolve ancient wheels",
      "matchManagers": ["poetry"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "onnxruntime-openvino, installed on top in Dockerfile.cpu_auto, has no release beyond 1.24.1",
      "matchManagers": ["poetry"],
      "matchPackageNames": ["onnxruntime"],
      "allowedVersions": "<1.25"
    },
    {
      "description": "onnxruntime-gpu is pinned against the tensorrt build, most combinations are broken",
      "matchManagers": ["poetry"],
      "matchPackageNames": ["onnxruntime-gpu"],
      "enabled": false
    },
    {
      "matchManagers": ["poetry"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "schedule": ["at any time"]
    }
  ]
}
